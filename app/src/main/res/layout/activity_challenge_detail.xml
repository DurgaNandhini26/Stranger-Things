<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="70dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:id="@+id/tvChalType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#CC0000"
                android:textSize="10sp"
                android:letterSpacing="0.35"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/tvChalName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:shadowColor="#FF0000"
                android:shadowRadius="12"
                android:layout_marginBottom="14dp"/>

            <TextView
                android:id="@+id/tvLore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#884444"
                android:textSize="12sp"
                android:textStyle="italic"
                android:lineSpacingExtra="3dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:background="#0A0000"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tvChalDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:lineSpacingExtra="5dp"
                android:layout_marginBottom="14dp"/>

            <TextView
                android:id="@+id/tvChalPoints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#CC0000"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="22dp"/>

            <EditText
                android:id="@+id/etFlag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="STF{...}"
                android:textColorHint="#333333"
                android:textColor="#FFFFFF"
                android:backgroundTint="#CC0000"
                android:inputType="text"
                android:fontFamily="monospace"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="SUBMIT FLAG"
                android:textColor="#FFFFFF"
                android:letterSpacing="0.15"
                android:background="@drawable/btn_red_border"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tvResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tvTotalScore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#555555"
                android:textSize="12sp"
                android:gravity="center"/>

        </LinearLayout>
    </ScrollView>

    <com.example.strangerthings.FairyLightsView
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_gravity="bottom"/>

</FrameLayout>